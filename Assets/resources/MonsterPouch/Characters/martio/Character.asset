  stableId: martio
  General:
    UsesDocumentedRules: 1
    AttackKind: 1
    BasicAttackName: Marte y sus lunas
    BasicAttackDescription: Lanza Marte y dos lunas por una trayectoria entrelazada.
      Cada proyectil afecta la casilla que atraviesa.
    SourceDocument: "Dise\xF1o del creador, 25 de octubre de 2026"
    SourcePages: 
    HasProvisionalBalance: 1
    EnergyMax: 0
    EnergyPerAttack: 0
    EnergyOnDamage: 0
    EnergyPerSecond: 0
    Id: martio
    DisplayName: Martio
    IsMonster: 0
    MaxHealth: 35
    Damage: 6
    AttackInterval: 1.3
    AttackWindup: 0.3
    AttackHold: 0.1
    AttackRecovery: 0.2
    ProjectileSpeed: 4.5
    AttackRange: 4
    MoveInterval: 0.9
    IQSpeed: 2
    BaseCost: 2
    TargetPolicy: 0
    Formation: 2
    BaseAbility:
      EffectId: martio-orbits
      Trigger: 0
      EveryAttacks: 0
      Id: martio-orbits
      Name: Sistema planetario
      Description: "Marte y dos lunas recorren hasta 7 casillas. Las lunas causan
        3 y 3 de da\xF1o."
      Parameters:
      - Key: firstMoonDamage
        Value: 3
      - Key: secondMoonDamage
        Value: 3
      - Key: travelRange
        Value: 7
      Cost: 0
      HealthBonus: 0
      DamageBonus: 0
      AttackIntervalMultiplier: 1
      RangeBonus: 0
      Armor: 0
      HealOnHit: 0
      BonusEveryHits: 0
      BonusDamage: 0
    Tricks:
    - EffectId: martio-explosion
      Trigger: 0
      EveryAttacks: 0
      Id: martio-explosion
      Name: Onda expansiva
      Description: "Cada impacto provoca una onda 3\xD73: Marte causa 6 y las lunas
        3 y 3 de da\xF1o a los rivales adyacentes. El centro recibe solo el impacto."
      Parameters:
      - Key: marsDamage
        Value: 6
      - Key: firstMoonDamage
        Value: 3
      - Key: secondMoonDamage
        Value: 3
      Cost: 3
      HealthBonus: 0
      DamageBonus: 0
      AttackIntervalMultiplier: 1
      RangeBonus: 0
      Armor: 0
      HealOnHit: 0
      BonusEveryHits: 0
      BonusDamage: 0
    - EffectId: martio-piercing
      Trigger: 0
      EveryAttacks: 0
      Id: martio-piercing
      Name: "Perforaci\xF3n"
      Description: "Atraviesan a los rivales hasta terminar su recorrido. Un impacto
        directo por rival y proyectil; las explosiones vecinas pueden volver a da\xF1arlos."
      Parameters: []
      Cost: 3
      HealthBonus: 0
      DamageBonus: 0
      AttackIntervalMultiplier: 1
      RangeBonus: 0
      Armor: 0
      HealOnHit: 0
      BonusEveryHits: 0
      BonusDamage: 0
    - EffectId: martio-moons
      Trigger: 0
      EveryAttacks: 0
      Id: martio-moons
      Name: Abanico planetario
      Description: "Añade dos grupos de Marte y lunas a ±{fanAngleDegrees}°. Recorrido lateral: {lateralTravelRange} casillas. Conservan el daño base y las mejoras de explosión y perforación."
      Parameters:
      - Key: lateralTravelRange
        Value: 3
      - Key: fanAngleDegrees
        Value: 30
      Cost: 3
      HealthBonus: 0
      DamageBonus: 0
      AttackIntervalMultiplier: 1
