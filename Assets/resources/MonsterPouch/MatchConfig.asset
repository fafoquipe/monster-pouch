      RangeBonus: 0
      Armor: 0
      HealOnHit: 0
      BonusEveryHits: 0
      BonusDamage: 0
    Tricks:
    - EffectId: tsu-death-trap
      Trigger: 0
      EveryAttacks: 0
      Id: tsu-death-trap
      Name: Cabello Pegajoso
      Description: "Cuando Tsu es derrotado, deja caer su cabello de chicle sobre
        la casilla donde muri\xF3. La casilla queda convertida en una trampa permanente.
        El primer enemigo que entre en ella queda inmovilizado en esa casilla y no
        puede abandonarla. La trampa permanece activa mientras ese enemigo siga vivo
        y desaparece cuando es derrotado."
      Cost: 3
      HealthBonus: 0
      DamageBonus: 0
      AttackIntervalMultiplier: 1
      RangeBonus: 0
      Armor: 0
